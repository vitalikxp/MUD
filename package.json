{
  "name": "mud",
  "private": true,
  "version": "0.1.0",
  "description": "AI Dungeon Master in a Norton Commander-style terminal",
  "license": "0BSD",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:check": "python3 scripts/check_docs.py",
    "relay:dev": "pnpm dlx wrangler@4 dev --config relay/wrangler.toml",
    "relay:deploy": "pnpm dlx wrangler@4 deploy --config relay/wrangler.toml",
    "eval:dm": "vitest run --config evals/vitest.config.ts",
    "eval:rescore": "vitest run --config evals/vitest.config.ts evals/rescore.eval.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "idb": "^8.0.3",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
