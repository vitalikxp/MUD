{
  "name": "swrd",
  "private": true,
  "version": "0.1.0",
  "description": "SWRD — AI Dungeon Master in a Norton Commander-style terminal",
  "license": "0BSD",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:check": "python3 scripts/check_docs.py"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
